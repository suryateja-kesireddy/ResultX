generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int       @id @default(autoincrement())
  name      String
  email     String    @unique
  password  String
  role      Role
  isActive  Boolean   @default(true)
  deletedAt   DateTime?
  lastLogin DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  examCell  ExamCell?
  hod       HOD?
  student   Student?
}

model Course {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  code        String       @unique
  duration    Int
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  departments Department[]
}

model Department {
  id        Int       @id @default(autoincrement())
  name      String
  code      String    @unique
  courseId  Int
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  course    Course    @relation(fields: [courseId], references: [id])
  hods      HOD[]
  students  Student[]
  subjects  Subject[]

  @@unique([courseId, name])
  @@index([courseId])
}

model AcademicYear {
  id        Int        @id @default(autoincrement())
  year      String     @unique
  isCurrent Boolean    @default(false)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  semesters Semester[]
}

model Semester {
  id             Int          @id @default(autoincrement())
  number         Int
  type           SemesterType
  academicYearId Int
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  results        Result[]
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  students       Student[]
  subjects       Subject[]

  @@unique([number, academicYearId])
  @@index([academicYearId])
}

model Student {
  id           Int        @id @default(autoincrement())
  userId       Int        @unique
  hallTicket   String     @unique
  phone        String?    @db.VarChar(15)
  departmentId Int
  semesterId   Int
  section      String     @default("A")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  results      Result[]
  department   Department @relation(fields: [departmentId], references: [id])
  semester     Semester   @relation(fields: [semesterId], references: [id])
  user         User       @relation(fields: [userId], references: [id])

  @@index([departmentId])
  @@index([semesterId])
}

model HOD {
  id           Int        @id @default(autoincrement())
  userId       Int        @unique
  employeeId   String     @unique
  phone        String?    @db.VarChar(15)
  departmentId Int
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  department   Department @relation(fields: [departmentId], references: [id])
  user         User       @relation(fields: [userId], references: [id])

  @@index([departmentId])
}

model ExamCell {
  id         Int      @id @default(autoincrement())
  userId     Int      @unique
  employeeId String   @unique
  phone      String?  @db.VarChar(15)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id])
}

model Subject {
  id             Int             @id @default(autoincrement())
  code           String
  name           String
  credits        Int
  departmentId   Int
  semesterId     Int
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  resultSubjects ResultSubject[]
  department     Department      @relation(fields: [departmentId], references: [id])
  semester       Semester        @relation(fields: [semesterId], references: [id])

  @@unique([code, departmentId, semesterId])
  @@index([departmentId])
  @@index([semesterId])
}

model Result {
  id            Int             @id @default(autoincrement())
  studentId     Int
  semesterId    Int
  sgpa          Float
  cgpa          Float?
  status        ResultStatus
  isPublished   Boolean         @default(false)
  publishedDate DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  semester      Semester        @relation(fields: [semesterId], references: [id])
  student       Student         @relation(fields: [studentId], references: [id])
  subjects      ResultSubject[]

  @@unique([studentId, semesterId])
  @@index([studentId])
  @@index([semesterId], map: "Result_semesterId_fkey")
}

model ResultSubject {
  id            Int          @id @default(autoincrement())
  resultId      Int
  subjectId     Int
  internalMarks Int          @default(0)
  externalMarks Int          @default(0)
  totalMarks    Int          @default(0)
  grade         Grade
  status        ResultStatus
  result        Result       @relation(fields: [resultId], references: [id])
  subject       Subject      @relation(fields: [subjectId], references: [id])

  @@unique([resultId, subjectId])
  @@index([subjectId], map: "ResultSubject_subjectId_fkey")
}

model Notification {
  id          Int                @id @default(autoincrement())
  title       String
  message     String             @db.Text
  target      NotificationTarget
  isPublished Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

enum Role {
  STUDENT
  HOD
  EXAM_CELL
  ADMIN
}

enum ResultStatus {
  PASS
  FAIL
  WITHHELD
}

enum Grade {
  O
  A_PLUS
  A
  B_PLUS
  B
  C
  F
}

enum SemesterType {
  ODD
  EVEN
}

enum NotificationTarget {
  ALL
  STUDENT
  HOD
  EXAM_CELL
}
